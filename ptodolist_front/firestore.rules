rules_version = '2';

// 개인 전용 모델:
// - users/{uid} 및 하위 routines·categories·tasks·dailyRecords: 본인만 read/write
// - 그 외 모든 경로(구버전 친구/공유/푸시 컬렉션 포함)는 기본 deny

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /routines/{rid} {
        allow read, write: if isOwner(uid);
      }
      match /categories/{cid} {
        allow read, write: if isOwner(uid);
      }
      match /dailyRecords/{date} {
        allow read, write: if isOwner(uid);
      }
      match /tasks/{tid} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
