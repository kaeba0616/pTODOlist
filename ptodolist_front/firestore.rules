rules_version = '2';

// 친구 전용 SNS 모델 (강화판):
// - users: 본인 + 친구만 read, write 본인만
// - users/*/routines·categories·dailyRecords: 본인, 또는 (친구 && publicMode == 'friends') 만 read
// - users/*/tasks: 본인 전용
// - users/*/fcmTokens: 본인 전용 (푸시 토큰; 서버(Cloud Functions)는 Admin SDK 로 규칙 우회 접근)
// - friendCodes: read 로그인 유저 전체 (코드 → uid 조회), create 본인 uid 만, 수정/삭제 불가
// - friendships: 멤버만 read/delete, create 는 "받은 친구 요청이 존재하는 수락자"만, update 불가
// - friendRequests/{toUid}/incoming/{fromUid}: 받은 사람만 read, 보낸 사람 본인 명의로만 create
// - dailyShares: 본인, 또는 (친구 && 공유자 publicMode == 'friends') 만 read, 본인만 write

service cloud.firestore {
  match /databases/{database}/documents {

    // pairId = 정렬된 "uidA_uidB" — 앱의 Friendship.makePairId 와 동일 규칙
    function isFriend(uidA, uidB) {
      let pairId = uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
      return exists(/databases/$(database)/documents/friendships/$(pairId));
    }

    // publicMode 가 'friends' 일 때만 친구에게 데이터 노출.
    // 필드가 없거나 'off' 면 비공개 (앱의 PublicMode.fromString 과 동일한 기본값).
    function sharingOn(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.publicMode == 'friends';
    }

    function canReadShared(uid) {
      return request.auth != null && (
        request.auth.uid == uid
        || (isFriend(uid, request.auth.uid) && sharingOn(uid))
      );
    }

    match /users/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || isFriend(uid, request.auth.uid)
      );
      allow write: if request.auth != null && request.auth.uid == uid;

      match /routines/{rid} {
        allow read: if canReadShared(uid);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /categories/{cid} {
        allow read: if canReadShared(uid);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /dailyRecords/{date} {
        allow read: if canReadShared(uid);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /tasks/{tid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /friendships/{pairId} {
      // 멤버 본인만 조회 — 전체 친구 그래프 노출 차단
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;
      // 생성은 "요청을 받은 사람의 수락"만 허용 — 강제 친구 등록 차단.
      // acceptedBy == 본인 && 상대가 보낸 요청이 내 수신함에 존재해야 함.
      allow create: if request.auth != null
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 2
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.acceptedBy == request.auth.uid
                    && hasIncomingFrom(otherMember(request.resource.data.members));
      allow update: if false;
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.members;
    }

    function otherMember(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    function hasIncomingFrom(fromUid) {
      return exists(/databases/$(database)/documents/friendRequests/$(request.auth.uid)/incoming/$(fromUid));
    }

    match /friendRequests/{toUid}/incoming/{fromUid} {
      allow read: if request.auth != null && request.auth.uid == toUid;
      allow create: if request.auth != null
                    && request.auth.uid == fromUid
                    && request.resource.data.fromUid == fromUid;
      // 받은 쪽이 수락/거절(=delete), 보낸 쪽이 취소(=delete) 둘 다 허용
      allow delete: if request.auth != null
                    && (request.auth.uid == toUid || request.auth.uid == fromUid);
    }

    match /dailyShares/{shareId} {
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || (isFriend(resource.data.uid, request.auth.uid) && sharingOn(resource.data.uid))
      );
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
